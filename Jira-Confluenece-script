#!/bin/bash

PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/root/bin'
CONFIG_FILE='/apps/scripts/confluence-backup.conf'
source $CONFIG_FILE

TIMESTAMP=`date +%d-%b-%Y`

CONFLUENCE_FULL_BACKUP_OP="${BACKUP_DIR}/confluence-full-backup-${TIMESTAMP}.tar.gz"

if [ -e ${CONFIG_FILE} ]; then
    source ${CONFIG_FILE}
else
    echo "Error: ${CONFIG_FILE} missing"
    exit 1
fi

function setup() {
    if [ ! -d "${BACKUP_DIR}" ]; then
        echo "Creating ${BACKUP_DIR}"
        mkdir -p "${BACKUP_DIR}"
    fi
}

function confluence_fullbackup() {
    echo -e '\n'
    echo "Dumping confluence database"
    mysqldump -u "${DB_USER}" -p"$DB_PASSWD" -h "${DB_HOST}" "${DB_NAME}" > ${BACKUP_DIR}/confluence-database-dump.sql
    echo "Confluence DB Dump Created"
    echo -e '\n'
    echo "Backing up Confluence Home & Installation Directory"
    echo ${BKP_USER_PWD} | sudo -S tar --exclude="logs/*.log" -cvpf ${BACKUP_DIR}/confluence-home-backup.tar -C ${CONFLUENCE_HOME_DIR} .
    echo ${BKP_USER_PWD} | sudo -S tar --exclude="logs/*.log" --exclude="logs/*.out" --exclude="logs/*.current" --exclude="logs/*.out" -cvpf ${BACKUP_DIR}/confluence-install-backup.tar -C ${CONFLUENCE_INSTALL_DIR} .
    echo ${BKP_USER_PWD} | sudo -S tar -zcvpf  ${CONFLUENCE_FULL_BACKUP_OP} -C ${BACKUP_DIR} confluence-home-backup.tar confluence-install-backup.tar confluence-database-dump.sql

    echo -e '\n'
    echo "Confluence Backup created in the Confluence Server : Location --> ${CONFLUENCE_FULL_BACKUP_OP}"
}

function delete_oldbackups () {
    echo -e '\n'
    echo "Deleting Backup Files older than 14 days in Confluence Server..."
    find  "${BACKUP_DIR}" -mtime +14 -type f -delete

}

function main() {
    echo -e '\n'
    echo "Backing up Confluence"
    setup
    confluence_fullbackup
    delete_oldbackups
    echo -e '\n'
}

main

