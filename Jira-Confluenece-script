[root@B ~]# cat /apps/scripts/jira-backup.sh
#!/bin/bash

NOW=`date +%Y-%b-%d-%H%M`
DATE=`date +%d-%b-%Y`
PATH=/sbin:/bin:/usr/sbin:/usr/bin
DB_USER=root
DB_HOST=x.x.x.x
DB_NAME=xxxxxx
DB_PASSWD=xxxxxxxxxx
BACKUP_DIR=/apps/backups/jira
JIRA_XML_BACKUP_DIR=/apps/atlassian/jira-home/application-data/export
JIRA_ATTACHMENTS_BACKUP_DIR=/apps/atlassian/jira-home/application-data/data
WORKSPACE=/apps/workspace/Jira-Backup

#Delete Backup Files older than 14 days in Jira Server..."
find "${BACKUP_DIR}" -mtime +14 -type f -delete

#clean up old files from workspace before backup process runs
rm -rf "${WORKSPACE}"/*

#Jira DB backup"
mysqldump -u "${DB_USER}" -p"$DB_PASSWD" -h "${DB_HOST}" "${DB_NAME}" > ${WORKSPACE}/jira-database-dump-${NOW}.sql

#Jira attachments and avatars backup"
tar -zcvf ${WORKSPACE}/jira-attachments-${NOW}.tar.gz -C ${JIRA_ATTACHMENTS_BACKUP_DIR} .

#Fetch latest Jira xml backup generated by jira system"
cp `find $JIRA_XML_BACKUP_DIR -maxdepth 2 -type f -mtime -1` $WORKSPACE

#zip all backups
zip -j -r ${WORKSPACE}/jira-full-backup-${DATE}.zip `find ${WORKSPACE} -maxdepth 1 -type f -mtime -1`

cp ${WORKSPACE}/jira-full-backup-${DATE}.zip ${BACKUP_DIR}

chown backupuser:backupuser ${WORKSPACE}/jira-full-backup-${DATE}.zip
