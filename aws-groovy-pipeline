pipeline {

    agent any

    environment {
        ENV               = 'dev'
        APP_NAME          = 'xxxxx'
        GITHUB_URL        = 'https://github.com/xxxxxxxx.git'

        AWS_REGION        = 'eu-west-1'
        AWS_ACCOUNT_ID    = 'xxxxxxxxxxxxxxxxx'
        ECR               = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPO          = "${ECR}/uam/${ENV}/${APP_NAME}"

        EKS_CLUSTER_NAME  = 'cluster'
        NAMESPACE         = 'dev'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${BRANCH_NAME}"]],
                    extensions: [[$class: 'WipeWorkspace']],
                    userRemoteConfigs: [[
                        credentialsId: 'uam-eotbuild-server',
                        url: "${GITHUB_URL}"
                    ]]
                ])
            }
        }

        stage('Compile') {
            steps {
                script {
                    env.JAVA_HOME = tool 'Java17'
                }
                sh """
                    echo ${JAVA_HOME}
                    /opt/gradle/gradle8/bin/gradle clnbld -x test --no-daemon --refresh-dependencies
                """
            }
        }

        stage('Build & Push Image') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${ECR}

                    docker build -t ${ECR_REPO}:${BUILD_NUMBER} .
                    docker -- push ${ECR_REPO}:${BUILD_NUMBER}
                """
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh """
                    aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER_NAME}

                    kubectl set image deployment/${APP_NAME} \
                        ${APP_NAME}=${ECR_REPO}:${BUILD_NUMBER} \
                        --namespace=${NAMESPACE}

                    kubectl rollout status deployment/${APP_NAME} \
                        --namespace=${NAMESPACE} --watch=false
                """
            }
        }
    }
}
